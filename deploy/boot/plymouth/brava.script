# FIAT Brava boot splash: the Traccia still (full canvas, already on the background colour), centred. The early desktop splash and the
# app's opening screen show the same picture, so the hand-over from boot to app cannot be seen. Pictures come from tools/make-brand.mjs.
#
# The screen changes shape during boot (the firmware's framebuffer first, then the real graphics driver takes over), so the layout is
# worked out again whenever the size changes, not once at the start.

# Same colour as the app's opening screen (#060a14).
Window.SetBackgroundTopColor(0.0235, 0.0392, 0.0784);
Window.SetBackgroundBottomColor(0.0235, 0.0392, 0.0784);

# The monitor is mounted on its side, but the boot framebuffer is the panel's own landscape shape, so on a landscape screen the picture
# used is the one already turned a quarter turn clockwise (splash-landscape.png, 1920x1080). Plymouth's runtime Rotate would cut it.
portrait_image = Image("splash-portrait.png");
landscape_image = Image("splash-landscape.png");
splash = Sprite();

state = [];
state.width = 0;
state.height = 0;
state.frame = 0;

fun layout() {
	screen_w = Window.GetWidth();
	screen_h = Window.GetHeight();
	if (screen_w == state.width && screen_h == state.height) return;
	state.width = screen_w;
	state.height = screen_h;

	if (screen_w > screen_h) source = landscape_image;
	else source = portrait_image;

	# Fit the whole picture inside the screen without changing its shape (native size when the screen is 1080x1920 / 1920x1080).
	scale = Math.Min(screen_w / source.GetWidth(), screen_h / source.GetHeight());
	if (scale == 1) shown = source;
	else shown = source.Scale(source.GetWidth() * scale, source.GetHeight() * scale);
	splash.SetImage(shown);
	splash.SetPosition((screen_w - shown.GetWidth()) / 2, (screen_h - shown.GetHeight()) / 2, 10);
}

# A short fade in, then it holds perfectly still.
fun refresh() {
	layout();
	state.frame++;
	splash.SetOpacity(Math.Min(1, state.frame / 25));
}
Plymouth.SetRefreshFunction(refresh);
layout();
