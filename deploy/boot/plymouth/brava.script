# FIAT Brava boot splash: a flat dark background with the logo in the middle. The app's own opening screen (src/index.html) draws the same
# picture in the same place and size, so the hand-over from boot to app cannot be seen. Pictures come from tools/make-brand.mjs.
#
# The screen changes shape during boot (the firmware's framebuffer first, then the real graphics driver takes over), so the layout is
# worked out again whenever the size changes, not once at the start.

# Same colour as the app's opening screen (#060a14).
Window.SetBackgroundTopColor(0.0235, 0.0392, 0.0784);
Window.SetBackgroundBottomColor(0.0235, 0.0392, 0.0784);

# The monitor is mounted on its side, but the boot framebuffer is the panel's own landscape shape: turn the picture to suit.
# A quarter turn one way or the other; if the logo comes up upside down, change the sign here.
quarter_turn = 1.5707963;

source_logo = Image("logo.png");
source_glow = Image("glow.png");
glow = Sprite();
logo = Sprite();

state = [];
state.width = 0;
state.height = 0;
state.frame = 0;

fun layout() {
	screen_w = Window.GetWidth();
	screen_h = Window.GetHeight();
	if (screen_w == state.width && screen_h == state.height) return;
	state.width = screen_w;
	state.height = screen_h;

	short_side = Math.Min(screen_w, screen_h);
	logo_w = short_side * 0.9;
	logo_h = logo_w * source_logo.GetHeight() / source_logo.GetWidth();
	logo_image = source_logo.Scale(logo_w, logo_h);
	glow_image = source_glow.Scale(logo_w, logo_h);
	if (screen_w > screen_h) {
		logo_image = logo_image.Rotate(quarter_turn);
		glow_image = glow_image.Rotate(quarter_turn);
	}
	x = (screen_w - logo_image.GetWidth()) / 2;
	y = (screen_h - logo_image.GetHeight()) / 2;
	glow.SetImage(glow_image);
	glow.SetPosition(x, y, 10);
	logo.SetImage(logo_image);
	logo.SetPosition(x, y, 11);
}

# A short fade in, then it holds perfectly still.
fun refresh() {
	layout();
	state.frame++;
	opacity = Math.Min(1, state.frame / 25);
	glow.SetOpacity(opacity);
	logo.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh);
layout();
