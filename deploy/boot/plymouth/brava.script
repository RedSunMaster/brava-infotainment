# FIAT Brava boot splash: the Matrice animation (amber LED dot-matrix), played once at 24 fps, then held on its last frame for as long as
# boot takes. The early desktop splash and the app's opening screen open on that same last frame, so the hand-over cannot be seen.
# Frames come from tools/make-brand.mjs: portrait-0001..0062.png and landscape-0001..0062.png (transparent, full canvas).
#
# Only the frame on screen is kept in memory (each is loaded when it is due), so the animation costs one frame's worth of memory, not 62.
# The screen changes shape during boot (the firmware's framebuffer first, then the real graphics driver takes over), so the layout and
# the frame set are worked out again whenever the size changes; the animation carries on from where it was.

# Same colour as the app's opening screen (#0a0705).
Window.SetBackgroundTopColor(0.0392, 0.0275, 0.0196);
Window.SetBackgroundBottomColor(0.0392, 0.0275, 0.0196);

FRAMES = 62;          # the last one is the held end
TICKS_PER_FRAME = 50 / 24;   # Plymouth calls refresh about 50 times a second; the animation is 24 fps

digits[0] = "0"; digits[1] = "1"; digits[2] = "2"; digits[3] = "3"; digits[4] = "4";
digits[5] = "5"; digits[6] = "6"; digits[7] = "7"; digits[8] = "8"; digits[9] = "9";

fun frame_name(prefix, n) {
	tens = Math.Int(n / 10);
	return prefix + "-00" + digits[tens] + digits[n - tens * 10] + ".png";
}

splash = Sprite();
splash.SetZ(10);

state = [];
state.width = 0;
state.height = 0;
state.prefix = "portrait";
state.tick = 0;
state.shown = 0;      # the frame number on screen (0 = none yet)

fun show(n) {
	source = Image(frame_name(state.prefix, n));
	# Fit the whole picture inside the screen without changing its shape (native size when the screen is 1080x1920 / 1920x1080).
	scale = Math.Min(state.width / source.GetWidth(), state.height / source.GetHeight());
	if (scale == 1) shown = source;
	else shown = source.Scale(source.GetWidth() * scale, source.GetHeight() * scale);
	splash.SetImage(shown);
	splash.SetPosition((state.width - shown.GetWidth()) / 2, (state.height - shown.GetHeight()) / 2, 10);
	state.shown = n;
}

fun refresh() {
	screen_w = Window.GetWidth();
	screen_h = Window.GetHeight();
	changed = 0;
	if (screen_w != state.width || screen_h != state.height) {
		state.width = screen_w;
		state.height = screen_h;
		# The monitor is mounted on its side; on a landscape screen use the frames already turned a quarter turn clockwise
		# (Plymouth's runtime Rotate would cut the ends off).
		if (screen_w > screen_h) state.prefix = "landscape";
		else state.prefix = "portrait";
		changed = 1;
	}

	n = Math.Min(FRAMES, Math.Int(state.tick / TICKS_PER_FRAME) + 1);
	state.tick++;
	if (changed || n != state.shown) show(n);
}
Plymouth.SetRefreshFunction(refresh);
refresh();
