[Unit]
Description=Brava kiosk (sway and the app)
After=systemd-user-sessions.service plymouth-quit.service systemd-logind.service getty@tty1.service
Wants=dbus.socket systemd-logind.service plymouth-quit.service
# Starting this on a running GNOME car stops GDM first; the normal boot never starts it.
Conflicts=getty@tty1.service gdm.service

[Service]
Type=simple
User=brava
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=LIBSEAT_BACKEND=logind
ExecStart=/usr/bin/sway -c /home/brava/.config/sway/brava-kiosk.conf
Restart=on-failure
RestartSec=2
